[458.025689, "o", "\u001b[1;6Hbecome_user: git\r\n   \u001b[2;4H\u001b[K\u001b[3;1H   - name: Add User\u001b[3;20H\u001b[K\u001b[4;6Hansible.builtin.user:\u001b[5;7Hname: gitea-runner\u001b[6;7Hsystem: true\u001b[7;7Hshell: /bin/bash\u001b[8;7Hhome: /var/lib/gitea-runner\u001b[9;7Hcreate_home: true\u001b[10;7Hcomment: 'Git Version Control'\u001b[12;4H- name: Create Runner File struct\u001b[13;6Hansible.builtin.shell: |\u001b[14;7Hmkdir -p /etc/gitea-runner\u001b[15;7H/usr/local/bin/gitea-runner config init --force -c /etc/gitea-runner/config.yaml\u001b[16;7H/usr/local/bin/gitea-runner config -c /etc/gitea-runner/config.yaml set runner.labels \"\"ubuntu-latest:host\"\"\u001b[17;7Hchown -R gitea-runner:gitea-runner /etc/gitea-runner\u001b[18;7Hchmod -R 750 /etc/gitea-runner/config.yaml\u001b[19;7Hcd /var/lib/gitea-runner\u001b[21;4H- name: Register runner\u001b[22;6Hansible.builtin.shell: /usr/local/bin/gitea-runner register -c /etc/gitea-runner/config.yaml --instance http://localhost::\u001b[23;1H3000 --token {{runner_token}} --no-interactive\u001b[24;6Hbecome_user: gitea-runner\r\n   - name: Start Gitea Runner\u001b[26;6Hansible.builtin.systemd_service:\u001b[27;7Hname: gitea-runner\u001b[28;7Hstate: started\u001b[29;7Henabled: true\u001b[30;7Hdaemon_reload: true\u001b[31;6Hbecome_user: gitea-runner\u001b[33;109H92,58\u001b[9CBot\u001b[17;58H\u001b[?25h\u001b[?4m"]
