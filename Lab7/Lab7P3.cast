[399.372916, "o", "\u001b[1;7Hcomment: 'Git Version Control'\r\n   \u001b[2;4H\u001b[K\u001b[3;1H   - name: Create Runner File struct\u001b[3;37H\u001b[K\u001b[4;6Hansible.builtin.shell: |\u001b[5;7Hmkdir -p /etc/gitea-runner\u001b[6;7H/usr/local/bin/gitea-runner config init --force -c /etc/gitea-runner/config.yaml\u001b[7;7H/usr/local/bin/gitea-runner config -c /etc/gitea-runner/config.yaml set runner.labels \"\"ubuntu-latest:host\"\"\u001b[8;7Hchown -R gitea-runner:gitea-runner /etc/gitea-runner\u001b[9;7Hchmod -R 750 /etc/gitea-runner/config.yaml\u001b[10;7Hcd /var/lib/gitea-runner\u001b[12;4H- name: Register runner\u001b[13;6Hansible.builtin.shell: /usr/local/bin/gitea-runner register -c /etc/gitea-runner/config.yaml --instance http://localhost:30000\u001b[14;1H --token {{runner_token}} --no-interactive\u001b[15;6Hbecome_user: gitea-runner\r\n   - name: Start Gitea Runner\u001b[17;6Hansible.builtin.systemd_service:\u001b[18;7Hname: gitea-runner\u001b[19;7Hstate: started\u001b[20;7Henabled: true\u001b[21;7Hdaemon_reload: true\u001b[22;6Hbecome_user: gitea-runner\u001b[24;113H97,28\u001b[9CBot\u001b[13;28H\u001b[?25h\u001b[?4m"]
