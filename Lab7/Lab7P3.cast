[123.799754, "o", "\u001b[1;4H- name: Start Running Gitea\r\n     ansible.builtin.systemd_service:\u001b[2;38H\u001b[K\u001b[3;1H      name: gitea\u001b[3;18H\u001b[K\u001b[4;7Hstate: started\u001b[5;7Henabled: true\u001b[6;6Hbecome_user: git\u001b[8;4H- name: Add User\u001b[9;6Hansible.builtin.user:\u001b[10;7Hname: gitea-runner\u001b[11;7Hsystem: true\u001b[12;7Hshell: /bin/bash\u001b[13;7Hhome: /var/lib/gitea-runner/\u001b[14;7Hcreate_home: yes\u001b[15;7Hcomment: 'Git Version Control'\u001b[17;4H- name: Create Runner File struct\u001b[18;6Hansible.builtin.shell: |\u001b[19;7Hmkdir -p /etc/gitea-runner\u001b[20;7H/usr/local/bin/gitea-runner config init --force -c /etc/gitea-runner/config.yaml\u001b[21;7H/usr/local/bin/gitea-runner config -c /etc/gitea-runner/config.yaml set runner.labels \"\"ubuntu-latest:host\"\"\u001b[22;7Hchown -R gitea-runner:gitea-runner /etc/gitea-runner\u001b[23;7Hchmod -R 750 /etc/gitea-runner/config.yaml\u001b[24;113H82,1\u001b[10C84%\u001b[12;1H\u001b[?25h\u001b[?4m"]
