[5687.665315, "o", "\u001b[1;5H\u001b[38;5;130mif\u001b[m num_list == \u001b[36mNone\u001b[m:\r\n        num_list = []\u001b[2;22H\u001b[K\u001b[3;1H    \u001b[38;5;130mif\u001b[m k <= \u001b[31m0\u001b[m:\u001b[3;15H\u001b[K\u001b[4;9H\u001b[38;5;130mreturn\u001b[m num_list\u001b[6;5Hlength = \u001b[36mlen\u001b[m(num_list)\r\n    \u001b[36mprint\u001b[m(length)\r\n    \u001b[38;5;130mif\u001b[m length == \u001b[31m0\u001b[m:\u001b[9;9Hnum_list.append(\u001b[31m0\u001b[m)\u001b[10;9Hfibit(k-\u001b[31m1\u001b[m,num_list)\r\n    \u001b[38;5;130mif\u001b[m length == \u001b[31m1\u001b[m:\u001b[12;9Hnum_list.append(\u001b[31m1\u001b[m)\u001b[13;9Hfibit(k-\u001b[31m1\u001b[m, num_list)\u001b[15;5Hnum_list.append(num_list[length - \u001b[31m1\u001b[m] + num_list[length - \u001b[31m2\u001b[m])\r\n    fibit(k-\u001b[31m1\u001b[m, num_list)\r\n\r\n\r\n\u001b[38;5;130mdef\u001b[m \u001b[36moutputToFile\u001b[m(x):\r\n    \u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m\"output/fib.txt\"\u001b[m, \u001b[31m\"w\"\u001b[m) \u001b[38;5;130mas\u001b[m f:\u001b[21;9H\u001b[36mprint\u001b[m(x, file=f)\r\n\r\noutputToFile(fibit(\u001b[31m5\u001b[m))\u001b[24;63H23,0-1\u001b[8CBot\u001b[22;1H\u001b[?25h\u001b[?4m"]
