[6233.980533, "o", "\u001b[1;1H\u001b[38;5;130mdef\u001b[m \u001b[36mfibit\u001b[m(k,num_list=\u001b[36mNone\u001b[m):\r\n    \u001b[38;5;130mif\u001b[m num_list == \u001b[36mNone\u001b[m:\u001b[2;25H\u001b[K\u001b[3;1H        num_list = []\u001b[3;22H\u001b[K\u001b[4;5H\u001b[38;5;130mif\u001b[m k <= \u001b[31m0\u001b[m:\u001b[5;9H\u001b[38;5;130mreturn\u001b[m num_list\u001b[7;5Hlength = \u001b[36mlen\u001b[m(num_list)\r\n    \u001b[36mprint\u001b[m(k)\r\n    \u001b[36mprint\u001b[m(length)\r\n    \u001b[36mprint\u001b[m(num_list)\r\n    \u001b[38;5;130mif\u001b[m length == \u001b[31m0\u001b[m:\u001b[12;9Hnum_list.append(\u001b[31m0\u001b[m)\u001b[13;9H\u001b[38;5;130mreturn\u001b[m fibit(k-\u001b[31m1\u001b[m,num_list)\r\n    \u001b[38;5;130mif\u001b[m length == \u001b[31m1\u001b[m:\u001b[15;9Hnum_list.append(\u001b[31m1\u001b[m)\u001b[16;9H\u001b[38;5;130mreturn\u001b[m fibit(k-\u001b[31m1\u001b[m, num_list)\r\n    \u001b[36mprint\u001b[m(k)\r\n    num_list.append(num_list[length - \u001b[31m1\u001b[m] + num_list[length - \u001b[31m2\u001b[m])\r\n    \u001b[38;5;130mreturn\u001b[m fibit(k-\u001b[31m1\u001b[m, num_list)\r\n\r\n\r\n\u001b[38;5;130mdef\u001b[m \u001b[36moutputToFile\u001b[m(x):\r\n    \u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m\"output/fib.txt\"\u001b[m, \u001b[31m\"w\"\u001b[m) \u001b[38;5;130mas\u001b[m f:\u001b[24;63H16,24\u001b[9CTop\u001b[16;24H\u001b[?25h\u001b[?4m"]
