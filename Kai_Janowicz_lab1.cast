[6337.46434, "o", "\u001b[1;1H\u001b[38;5;130mdef\u001b[m \u001b[36mfibit\u001b[m(k,num_list=\u001b[36mNone\u001b[m):\r\n    \u001b[38;5;130mif\u001b[m num_list == \u001b[36mNone\u001b[m:\u001b[2;25H\u001b[K\u001b[3;1H        num_list = []\u001b[3;22H\u001b[K\u001b[4;5H\u001b[38;5;130mif\u001b[m k <= \u001b[31m0\u001b[m:\u001b[5;9H\u001b[38;5;130mreturn\u001b[m num_list\u001b[7;5Hlength = \u001b[36mlen\u001b[m(num_list)\r\n    \u001b[38;5;130mif\u001b[m length == \u001b[31m0\u001b[m:\u001b[9;9Hnum_list.append(\u001b[31m0\u001b[m)\u001b[10;9H\u001b[38;5;130mreturn\u001b[m fibit(k-\u001b[31m1\u001b[m,num_list)\r\n    \u001b[38;5;130mif\u001b[m length == \u001b[31m1\u001b[m:\u001b[12;9Hnum_list.append(\u001b[31m1\u001b[m)\u001b[13;9H\u001b[38;5;130mreturn\u001b[m fibit(k-\u001b[31m1\u001b[m, num_list)\r\n    num_list.append(num_list[length - \u001b[31m1\u001b[m] + num_list[length - \u001b[31m2\u001b[m])\r\n    \u001b[38;5;130mreturn\u001b[m fibit(k-\u001b[31m1\u001b[m, num_list)\r\n\r\n\r\n\u001b[38;5;130mdef\u001b[m \u001b[36moutputToFile\u001b[m(x):\r\n    \u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m\"output/fib.txt\"\u001b[m, \u001b[31m\"w\"\u001b[m) \u001b[38;5;130mas\u001b[m f:\u001b[20;9H\u001b[36mprint\u001b[m(x, file=f)\r\n\r\noutputToFile(fibit\u001b[106m(\u001b[m\u001b[31m20\u001b[m\u001b[106m)\u001b[m)\r\n\u001b[94m~                                                                               \u001b[m\u001b[24;63H22,22\u001b[9CAll\u001b[22;22H\u001b[?25h\u001b[?4m"]
[6337.469189, "o", "\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001bP$q q\u001b\\\u001b[?12$p"]
[6337.471122, "o", "\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[1;1H\u001b[93mdef\u001b[m \u001b[1m\u001b[96mfibit\u001b[m(k,num_list=\u001b[1m\u001b[96mNone\u001b[m):\r\n    \u001b[93mif\u001b[m num_list == \u001b[1m\u001b[96mNone\u001b[m:\u001b[3;9Hnum_list = []\r\n    \u001b[93mif\u001b[m k <= \u001b[95m0\u001b[m:\u001b[5;9H\u001b[93mreturn\u001b[m num_list\u001b[7;5Hlength = \u001b[1m\u001b[96mlen\u001b[m(num_list)\r\n    \u001b[93mif\u001b[m length == \u001b[95m0\u001b[m:\u001b[9;9Hnum_list.append(\u001b[95m0\u001b[m)\u001b[10;9H\u001b[93mreturn\u001b[m fibit(k-\u001b[95m1\u001b[m,num_list)\r\n    \u001b[93mif\u001b[m length == \u001b[95m1\u001b[m:\u001b[12;9Hnum_list.append(\u001b[95m1\u001b[m)\u001b[13;9H\u001b[93mreturn\u001b[m fibit(k-\u001b[95m1\u001b[m, num_list)\r\n    num_list.append(num_list[length - \u001b[95m1\u001b[m] + num_list[length - \u001b[95m2\u001b[m])\r\n    \u001b[93mreturn\u001b[m fibit(k-\u001b[95m1\u001b[m, num_list)\r\n\r\n\r\n\u001b[93mdef\u001b[m \u001b[1m\u001b[96moutputToFile\u001b[m(x):\r\n    \u001b[93mwith\u001b[m \u001b[1m\u001b[96mopen\u001b[m(\u001b[95m\"output/fib.txt\"\u001b[m, \u001b[95m\"w\"\u001b[m) \u001b[93mas\u001b[m f:\u001b[20;9H\u001b[1m\u001b[96mprint\u001b[m(x, file=f)\r\n\r\noutputToFile(fibit\u001b[46m(\u001b[m\u001b[95m20\u001b[m\u001b[46m)\u001b[m)\r\n\u001b[94m~                                                                               \u001b[m\u001b[24;63H22,22\u001b[9CAll\r\"lab1.py\" 22L, 528B\u001b[22;22H\u001b[?25h"]
