[3846.583674, "o", "\u001b[1;1H\u001b[38;5;130mdef\u001b[m \u001b[36mfibit\u001b[m(t):\r\n    \u001b[38;5;130mif\u001b[m k = \u001b[31m0\u001b[m\u001b[2;13H\u001b[K\u001b[3;1H        outputToFile([])\u001b[3;25H\u001b[K\u001b[4;9H\u001b[38;5;130mreturn\r\n\u001b[m    \u001b[38;5;130mif\u001b[m k = \u001b[31m1\u001b[m\u001b[6;9HoutputToFile([\u001b[31m0\u001b[m,\u001b[31m1\u001b[m])\u001b[7;9H\u001b[38;5;130mreturn\u001b[m\r\n    out_list = [\u001b[31m0\u001b[m,\u001b[31m1\u001b[m,\u001b[31m1\u001b[m]\r\n    x = \u001b[31m1\u001b[m\r\n    y = \u001b[31m1\u001b[m\r\n    \u001b[38;5;130mwhile\u001b[m \u001b[36mlen\u001b[m(out_list) < n:\u001b[12;9Htempy = x\u001b[13;9Hx = x + y\u001b[14;9Hy = tempy\u001b[15;9Hout_list.append(x)\r\n    outputToFile(out_list)\r\n    \u001b[38;5;130mreturn\r\ndef\u001b[m \u001b[36moutputToFile\u001b[m(x):\r\n    \u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m\"output/fib.txt\"\u001b[m, \u001b[31m\"w\"\u001b[m) \u001b[38;5;130mas\u001b[m f:\u001b[20;9H\u001b[36mprint\u001b[m(x, file=f)\r\n\r\nfibit\u001b[106m(\u001b[m\u001b[31m25\u001b[m\u001b[106m)\u001b[m\r\n\u001b[94m~                                                                               \u001b[m\u001b[24;63H22,9\u001b[10CAll\u001b[22;9H\u001b[?25h\u001b[?4m"]
